import json
import re
import requests
from odoo import api, exceptions, fields, models


class StockPickingCustom(models.Model):
    _inherit = 'stock.picking'

    # =========================================================================
    # CAMPOS CUSTOMIZADOS E MAPEADOS (CONFORME ODOO)
    # =========================================================================
    #
    # IMPORTANTE:
    # Este modelo representa individualmente cada Pedido de Envio / Entrega
    # existente no Odoo.
    #
    # Exemplo:
    #
    # Entrega nº 75236
    #
    # Quando o usuário estiver dentro dessa entrega e clicar no botão
    # "Emitir NF-e", o método action_gerar_nfe_omie() será executado
    # diretamente sobre ESTE registro.
    #
    # Portanto:
    #
    # self = Entrega/Pedido de Envio atual
    #
    # Não é necessário procurar o Ticket/Entrega novamente.
    #

    numero_nota_fiscal = fields.Char(
        string="Número da Nota Fiscal",
        readonly=True,
        copy=False
    )

    # Campo nativo/customizado mapeado
    shipping_date = fields.Datetime(
        string="Data de Envio",
        readonly=True,
        copy=False
    )

    # Campo nativo/customizado mapeado
    expected_receipt_date = fields.Datetime(
        string="Previsão de Recebimento",
        readonly=True,
        copy=False
    )

    custo_frete = fields.Float(
        string="Custo do Frete",
        default=0.00,
        readonly=True
    )

    omie_nfe_status = fields.Char(
        string="Status NF-e Omie",
        readonly=True,
        copy=False
    )

    # =========================================================================
    # CREDENCIAIS OMIE
    # =========================================================================
    #
    # MOLDE:
    # As credenciais NÃO devem ficar diretamente no código em produção.
    #
    # O ideal é armazená-las em configuração segura do Odoo.
    #

    OMIE_APP_KEY = "SEU_APP_KEY"
    OMIE_APP_SECRET = "SEU_APP_SECRET"

    # O Cenário de Impostos no Omie deve estar previamente configurado com:
    # CST 90, IPI 53, PIS/COFINS 08, ICMS ST (Não calcular)
    # e Base (Valor da Operação)

    OMIE_CENARIO_COMODATO = "SEU_CODIGO_CENARIO_COMODATO"

    # =========================================================================
    # AÇÃO PRINCIPAL DO BOTÃO
    # =========================================================================
    #
    # Este método será associado ao botão que será inserido na tela
    # individual de cada Pedido de Envio / Entrega do Odoo.
    #
    # Exemplo:
    #
    # Usuário está em:
    #
    #     Entrega nº 75236
    #
    # Clica:
    #
    #     [ EMITIR NF-e ]
    #
    # Então:
    #
    #     self = stock.picking correspondente à Entrega nº 75236
    #
    # Todo o processo abaixo utilizará os dados dessa entrega específica.
    #

    def action_gerar_nfe_omie(self):
        self.ensure_one()

        # =====================================================================
        # 1. IDENTIFICAÇÃO DO PEDIDO DE ENVIO ATUAL
        # =====================================================================
        #
        # O registro atual é a própria entrega/pedido de envio que acionou
        # o botão.
        #
        # Não é necessário receber o ID por parâmetro nem pesquisar outra
        # entrega.
        #
        # Exemplo:
        #
        # self.id       -> ID interno da Entrega
        # self.name      -> número/referência da Entrega
        #
        # MOLDE:
        # Os campos exatos podem ser ajustados conforme a configuração
        # definitiva do Odoo.
        #

        envio_id = self.id
        envio_referencia = self.name

        # =====================================================================
        # 2. PROTEÇÃO CONTRA DUPLICIDADE
        # =====================================================================
        #
        # Impede que o mesmo Pedido de Envio seja enviado novamente ao Omie
        # caso o processo de faturamento já tenha sido iniciado.
        #
        # IMPORTANTE:
        # Na implementação definitiva, recomenda-se possuir campos separados
        # para:
        #
        # - Código do Pedido Omie
        # - Número do Pedido Omie
        # - Número da NF-e
        # - Chave da NF-e
        # - Status da NF-e
        #
        # Aqui permanece simplificado porque este código é um MOLDE.
        #

        if self.omie_nfe_status and (
            "PEDIDO_CRIADO" in self.omie_nfe_status
            or "FATURAMENTO_SOLICITADO" in self.omie_nfe_status
            or "AUTORIZADA" in self.omie_nfe_status
        ):
            raise exceptions.UserError(
                "Este Pedido de Envio já possui uma operação "
                "de faturamento iniciada no Omie.\n\n"
                f"Entrega: {envio_referencia}\n"
                f"Status atual: {self.omie_nfe_status}"
            )

        # =====================================================================
        # 3. VALIDAÇÃO DA TRANSPORTADORA
        # =====================================================================
        #
        # Os dados são obtidos diretamente da Entrega/Pedido de Envio atual.
        #

        if not self.carrier:
            raise exceptions.UserError(
                "Selecione uma Transportadora antes de gerar a NF-e."
            )

        # =====================================================================
        # 4. VALIDAÇÃO DO CLIENTE E CONSULTA OMIE
        # =====================================================================
        #
        # O cliente também pertence à Entrega/Pedido de Envio atual.
        #

        if not self.partner_id or not self.partner_id.vat:
            raise exceptions.UserError(
                "O cliente associado a este Pedido de Envio "
                "não possui CNPJ/CPF cadastrado."
            )

        cnpj_limpo = re.sub(
            r"\D",
            "",
            self.partner_id.vat
        )

        # Consulta o cadastro correspondente no Omie.
        omie_client = self._consultar_cliente_omie(
            cnpj_limpo
        )

        if not omie_client:
            raise exceptions.UserError(
                f"O CNPJ/CPF {self.partner_id.vat} "
                "não está cadastrado no OMIE.\n\n"
                "Solicite a criação deste cadastro SEDE/LOCAL "
                "na plataforma OMIE antes do faturamento."
            )

        # =====================================================================
        # 5. VALIDAÇÃO DO ENDEREÇO
        # =====================================================================

        self._validar_endereco_omie(
            omie_client
        )

        # =====================================================================
        # 6. REGRA DE NEGÓCIO DOS PRODUTOS DO PEDIDO DE ENVIO
        #    UNIDADE ELETRÔNICA VS CHICOTE
        # =====================================================================
        #
        # Os produtos utilizados na emissão são aqueles pertencentes
        # diretamente à Entrega/Pedido de Envio que acionou o botão.
        #
        # Exemplo:
        #
        # Entrega nº 75236
        #
        # Produtos:
        #
        # - UNIDADES ELETRÔNICAS
        # - GOBO008...
        # - GOBO003...
        #
        # Portanto, a integração utiliza as linhas desta entrega.
        #

        linhas_itens = (
            self.move_ids_without_package
            or self.move_line_ids
        )

        if not linhas_itens:
            raise exceptions.UserError(
                "Não há itens/produtos associados "
                "a este Pedido de Envio para a geração da nota."
            )

        qtd_unidades = 0.0
        qtd_chicotes = 0.0

        for line in linhas_itens:

            nome_produto = (
                line.product_id.name or ""
            ).upper()

            sku_produto = (
                line.product_id.default_code or ""
            ).upper()

            qtd = (
                getattr(line, 'qty_done', 0.0)
                or getattr(line, 'product_uom_qty', 0.0)
            )

            # Identifica se a linha é um Chicote
            # pelo nome ou prefixo GOB.
            if (
                "CHICOTE" in nome_produto
                or "GOB-" in sku_produto
            ):
                qtd_chicotes += qtd

            else:
                # Caso contrário, considera Unidade Eletrônica (U.E).
                qtd_unidades += qtd

        # =====================================================================
        # 7. DEFINE QUANTIDADE, DESCRIÇÃO E PESO
        # =====================================================================

        if qtd_unidades > 0:

            qtd_faturar = qtd_unidades

            descricao_item = (
                "APARELHO DE RADIONAVEGAÇÃO CENTRAL DE TELEMETRIA, RADIONAVEGAÇÃO"
                "UNIDADES ELETRÔNICAS + CHICOTE"
            )

            # 300g por Unidade Eletrônica + Chicote.
            peso_total = qtd_faturar * 0.300

        elif qtd_chicotes > 0:

            qtd_faturar = qtd_chicotes

            descricao_item = (
                "CHICOTE ELÉTRICO PARA VEÍCULOS AUTOMOTORES"
            )

            # 200g por Chicote.
            peso_total = qtd_faturar * 0.200

        else:

            raise exceptions.UserError(
                "Não foi possível identificar "
                "Unidades ou Chicotes no Pedido de Envio."
            )

        # =====================================================================
        # 8. REGRA DO CFOP
        #    ESTADUAL VS INTERESTADUAL
        # =====================================================================

        estado_empresa = (
            self.company_id.state_id.code
        )

        estado_cliente = (
            self.partner_id.state_id.code
        )

        cfop_usado = (
            "5.908"
            if estado_empresa == estado_cliente
            else "6.908"
        )

        # =====================================================================
        # 9. CRIA PEDIDO DE VENDA NO OMIE
        # =====================================================================
        #
        # IMPORTANTE:
        #
        # O Pedido de Venda será criado especificamente para esta Entrega.
        #
        # Não é um pedido genérico.
        #
        # O identificador de integração utilizará o ID da Entrega:
        #
        #     ODOO-ENTREGA-75236
        #
        # Isso permite rastrear:
        #
        # Odoo Entrega 75236
        #        ↓
        # Pedido Omie
        #        ↓
        # NF-e
        #
        # A criação do Pedido de Venda NÃO significa que a NF-e já foi
        # autorizada.
        #

        pedido_omie = self._criar_pedido_venda_omie(
            omie_client=omie_client,
            qtd_faturar=qtd_faturar,
            descricao_item=descricao_item,
            cfop_usado=cfop_usado,
            peso_total=peso_total
        )

        # =====================================================================
        # 10. FATURA O PEDIDO DE VENDA
        # =====================================================================
        #
        # O Pedido de Venda criado especificamente para esta Entrega
        # será enviado ao processo de faturamento do Omie.
        #
        # A autorização final da NF-e pela SEFAZ deverá ser obtida
        # posteriormente via webhook ou consulta de status.
        #

        self._faturar_pedido_venda_omie(
            pedido_omie
        )

        # =====================================================================
        # 11. RETORNO VISUAL PARA O USUÁRIO
        # =====================================================================
        #
        # Após o clique, o usuário permanece trabalhando sobre a Entrega
        # atual.
        #
        # O Odoo informa que o processo foi iniciado.
        #

        return {
            "type": "ir.actions.client",
            "tag": "display_notification",
            "params": {
                "title": "NF-e enviada para faturamento",
                "message": (
                    f"A Entrega {envio_referencia} foi processada.\n\n"
                    "O Pedido de Venda foi criado e enviado "
                    "para faturamento no Omie.\n\n"
                    "A NF-e está aguardando processamento "
                    "e autorização da SEFAZ."
                ),
                "type": "success",
                "sticky": False,
            }
        }

    # =========================================================================
    # MÉTODO AUXILIAR
    # CRIAÇÃO DO PEDIDO DE VENDA NO OMIE
    # =========================================================================

    def _criar_pedido_venda_omie(
        self,
        omie_client,
        qtd_faturar,
        descricao_item,
        cfop_usado,
        peso_total
    ):
        """
        Cria o Pedido de Venda no Omie referente à Entrega/Pedido de Envio
        que acionou o botão.

        IMPORTANTE:
        O Pedido de Venda não deve ser confundido com a NF-e.

        Fluxo:

            Entrega Odoo
                  ↓
            IncluirPedido
                  ↓
            Pedido Omie
                  ↓
            FaturarPedidoVenda
                  ↓
                 NF-e
                  ↓
                SEFAZ
        """

        # =====================================================================
        # IDENTIFICADOR DA INTEGRAÇÃO
        # =====================================================================
        #
        # O ID utilizado é o da própria Entrega/Pedido de Envio.
        #
        # Exemplo:
        #
        # Entrega Odoo = 75236
        #
        # Identificador:
        #
        # ODOO-ENTREGA-75236
        #
        # Isso cria uma relação direta entre o registro do Odoo
        # e o Pedido criado no Omie.
        #

        codigo_integracao = (
            f"ODOO-ENTREGA-{self.id}"
        )

        # =====================================================================
        # ITENS DO PEDIDO
        # =====================================================================

        itens_payload = [{
            "ide": {
                "codigo_item_integracao": (
                    f"{codigo_integracao}-ITEM-1"
                )
            },

            "produto": {

                # MOLDE:
                # Substituir pelo código real do produto cadastrado no Omie.
                #
                # Unidade Eletrônica ou Unidade Eletrônica + Chicote:
                #
                # APARELHO DE RADIONAVEGAÇÃO CENTRAL DE TELEMETRIA,
                # RADIONAVEGAÇÃO
                #
                # Chicote:
                #
                # CHICOTE ELÉTRICO PARA VEÍCULOS AUTOMOTORES
                #
                # O código definitivo deverá ser definido conforme
                # o cadastro de produtos no Omie.

                "codigo_produto": 123456,

                "descricao": descricao_item,

                "quantidade": qtd_faturar,

                # Regra do exemplo:
                # R$ 1,00 por unidade.
                "valor_unitario": 1.00,

                "cfop": cfop_usado

                # MOLDE:
                # NCM, origem e demais informações fiscais podem ser
                # adicionados conforme o cadastro fiscal definido no Omie.
            }
        }]

        # =====================================================================
        # PAYLOAD DO PEDIDO DE VENDA
        # =====================================================================

        payload = {
            "call": "IncluirPedido",

            "app_key": self.OMIE_APP_KEY,

            "app_secret": self.OMIE_APP_SECRET,

            "param": [{
                "cabecalho": {

                    # Código do cliente cadastrado no Omie.
                    "codigo_cliente_omie": (
                        omie_client.get(
                            "codigo_cliente_omie"
                        )
                    ),

                    # Identificador da Entrega/Pedido de Envio no Odoo.
                    #
                    # NÃO utilizar numero_pedido como número da NF.
                    "codigo_pedido_integracao": (
                        codigo_integracao
                    ),

                    # Etapa do Pedido de Venda.
                    #
                    # MOLDE:
                    # confirmar conforme parametrização do Omie.
                    "etapa": "10",

                    "quantidade_itens": 1
                },

                "frete": {

                    # MOLDE:
                    # Confirmar modalidade de frete utilizada no Omie.
                    "modalidade_frete": "0",

                    "valor_frete": 0.00,

                    "quantidade_volumes": qtd_faturar,

                    "especie_volumes": "CAIXA",

                    "peso_bruto": peso_total,

                    "peso_liquido": peso_total
                },

                "det": itens_payload,

                "informacoes_adicionais": {

                    "dados_adicionais_nf": (
                        "Origem: Internacional. "
                        "Operacao de Remessa em Comodato. "
                        f"Entrega Odoo: {self.name}"
                    )
                }
            }]
        }

        # =====================================================================
        # REQUISIÇÃO HTTP - CRIA PEDIDO
        # =====================================================================

        url = (
            "https://app.omie.com.br/"
            "api/v1/produtos/pedido/"
        )

        headers = {
            "Content-Type": "application/json"
        }

        try:

            response = requests.post(
                url,
                json=payload,
                headers=headers,
                timeout=30
            )

            response.raise_for_status()

            res_data = response.json()

        except requests.exceptions.RequestException as e:

            raise exceptions.UserError(
                "Falha de conexão com a API do Omie "
                "ao criar o Pedido de Venda para esta Entrega:\n\n"
                f"{e}"
            )

        # =====================================================================
        # TRATAMENTO DA RESPOSTA
        # =====================================================================

        if res_data.get("faultstring"):

            raise exceptions.UserError(
                "Erro ao criar o Pedido de Venda no Omie:\n\n"
                f"{res_data.get('faultstring')}"
            )

        codigo_pedido = (
            res_data.get("codigo_pedido")
        )

        numero_pedido = (
            res_data.get("numero_pedido")
        )

        if not codigo_pedido:

            raise exceptions.UserError(
                "O Omie não retornou o código "
                "do Pedido de Venda.\n\n"
                f"Retorno recebido:\n{res_data}"
            )

        # =====================================================================
        # ATUALIZA STATUS NO ODOO
        # =====================================================================
        #
        # Atualiza SOMENTE a Entrega/Pedido de Envio que acionou o botão.
        #
        # Não existe alteração em outros pedidos.
        #
        # IMPORTANTE:
        # numero_pedido NÃO é número da NF-e.
        #

        self.write({
            "omie_nfe_status": (
                "PEDIDO_CRIADO - "
                f"Pedido Omie: "
                f"{numero_pedido or codigo_pedido}"
            )
        })

        # =====================================================================
        # RETORNO DO PEDIDO
        # =====================================================================

        return {
            "codigo_pedido": codigo_pedido,

            "numero_pedido": numero_pedido,

            "codigo_pedido_integracao": (
                codigo_integracao
            )
        }

    # =========================================================================
    # MÉTODO AUXILIAR
    # FATURAMENTO DO PEDIDO DE VENDA / EMISSÃO DA NF-e
    # =========================================================================

    def _faturar_pedido_venda_omie(
        self,
        pedido_omie
    ):
        """
        Solicita ao Omie o faturamento do Pedido de Venda relacionado
        à Entrega/Pedido de Envio atual.

        Fluxo:

            Entrega Odoo
                  ↓
            Pedido Omie
                  ↓
            FaturarPedidoVenda
                  ↓
            Processamento NF-e
                  ↓
                SEFAZ
                  ↓
            Autorizada/Rejeitada

        IMPORTANTE:
        O retorno desta chamada NÃO deve ser tratado automaticamente
        como NF-e autorizada.

        A autorização final deverá ser confirmada posteriormente
        através de webhook ou consulta da NF-e.
        """

        # =====================================================================
        # ENDPOINT DE FATURAMENTO
        # =====================================================================

        url = (
            "https://app.omie.com.br/"
            "api/v1/produtos/pedidovendafat/"
        )

        # =====================================================================
        # PAYLOAD
        # =====================================================================

        payload = {
            "call": "FaturarPedidoVenda",

            "app_key": self.OMIE_APP_KEY,

            "app_secret": self.OMIE_APP_SECRET,

            "param": [{

                # Código interno do Pedido de Venda no Omie.
                "nCodPed": (
                    pedido_omie[
                        "codigo_pedido"
                    ]
                ),

                # Identificador utilizado pela integração.
                "cCodIntPed": (
                    pedido_omie[
                        "codigo_pedido_integracao"
                    ]
                )
            }]
        }

        headers = {
            "Content-Type": "application/json"
        }

        # =====================================================================
        # REQUISIÇÃO HTTP
        # =====================================================================

        try:

            response = requests.post(
                url,
                json=payload,
                headers=headers,
                timeout=30
            )

            response.raise_for_status()

            res_data = response.json()

        except requests.exceptions.RequestException as e:

            self.write({
                "omie_nfe_status": (
                    "ERRO_FATURAMENTO"
                )
            })

            raise exceptions.UserError(
                "Falha de conexão com a API do Omie "
                "ao solicitar o faturamento:\n\n"
                f"{e}"
            )

        # =====================================================================
        # ERRO RETORNADO PELO OMIE
        # =====================================================================

        if res_data.get("faultstring"):

            self.write({
                "omie_nfe_status": (
                    "ERRO_FATURAMENTO"
                )
            })

            raise exceptions.UserError(
                "O Omie não conseguiu faturar "
                "o Pedido de Venda:\n\n"
                f"{res_data.get('faultstring')}"
            )

        # =====================================================================
        # STATUS DO FATURAMENTO
        # =====================================================================

        codigo_status = (
            res_data.get("cCodStatus")
        )

        descricao_status = (
            res_data.get("cDescStatus")
        )

        # MOLDE:
        # Os códigos exatos de sucesso/erro devem ser confirmados
        # conforme o método da API utilizado no ambiente Omie.

        if codigo_status and codigo_status not in (
            "0",
            "100"
        ):

            self.write({
                "omie_nfe_status": (
                    "ERRO_FATURAMENTO - "
                    f"{codigo_status}: "
                    f"{descricao_status}"
                )
            })

            raise exceptions.UserError(
                "O Omie retornou erro ao faturar "
                "o Pedido de Venda:\n\n"
                f"Código: {codigo_status}\n"
                f"Descrição: {descricao_status}"
            )

        # =====================================================================
        # STATUS NO ODOO
        # =====================================================================
        #
        # Neste ponto:
        #
        # Pedido criado       = SIM
        # Faturamento enviado = SIM
        # NF-e autorizada     = AINDA NÃO NECESSARIAMENTE
        #
        # Por isso NÃO preenchemos numero_nota_fiscal aqui.
        #
        # Este status pertence somente à Entrega que acionou o botão.
        #

        self.write({
            "omie_nfe_status": (
                "FATURAMENTO_SOLICITADO - "
                "Aguardando processamento "
                "da NF-e/SEFAZ"
            ),

            "shipping_date": fields.Datetime.now(),

            "custo_frete": 0.00
        })

        return res_data

    # =========================================================================
    # MÉTODO AUXILIAR
    # CONSULTA CLIENTE NO OMIE
    # =========================================================================

    def _consultar_cliente_omie(
        self,
        cnpj_cpf
    ):
        url = (
            "https://app.omie.com.br/"
            "api/v1/geral/clientes/"
        )

        payload = {
            "call": "PesquisarClientes",

            "app_key": self.OMIE_APP_KEY,

            "app_secret": self.OMIE_APP_SECRET,

            "param": [{
                "clientesFiltro": {
                    "cnpj_cpf": cnpj_cpf
                }
            }]
        }

        try:

            res = requests.post(
                url,
                json=payload,
                timeout=15
            )

            if res.status_code == 200:

                clientes = res.json().get(
                    "clientes_cadastro",
                    []
                )

                return (
                    clientes[0]
                    if clientes
                    else None
                )

        except requests.exceptions.RequestException:
            pass

        return None

    # =========================================================================
    # MÉTODO AUXILIAR
    # VALIDA ENDEREÇO ODOO X OMIE
    # =========================================================================

    def _validar_endereco_omie(
        self,
        omie_client
    ):

        cep_odoo = re.sub(
            r"\D",
            "",
            self.partner_id.zip or ""
        )

        cep_omie = re.sub(
            r"\D",
            "",
            omie_client.get(
                "cep",
                ""
            )
        )

        rua_odoo = (
            self.partner_id.street or ""
        ).strip().lower()

        rua_omie = (
            omie_client.get(
                "endereco",
                ""
            )
        ).strip().lower()

        if (
            cep_odoo != cep_omie
